<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TextField?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>

<fx:root type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml" spacing="6" alignment="CENTER_LEFT">
    <fx:define>
        <BindingList>
            <DirectBinding control="nameField" property="text" path="name" direction="both"/>
            <DirectBinding control="typeField" property="text" path="type" direction="both"/>
            <DirectBinding control="rdataField" property="text" path="rdata" direction="both"/>
            <DirectBinding control="ttlField" property="text" path="ttl" direction="both"/>
            <DirectBinding control="patternField" property="text" path="rdataPattern" direction="both"/>
            <DirectBinding control="deleteBox" property="selected" path="deletionMarker" direction="both"/>
        </BindingList>
    </fx:define>
    <TextField fx:id="nameField" promptText="Name" prefWidth="160" minWidth="160"/>
    <TextField fx:id="typeField" promptText="Type" prefWidth="70" minWidth="70"/>
    <TextField fx:id="rdataField" promptText="Rdata" prefWidth="200" minWidth="200"/>
    <TextField fx:id="ttlField" promptText="TTL" prefWidth="80" minWidth="80"/>
    <TextField fx:id="patternField" promptText="Pattern" prefWidth="120" minWidth="120"/>
    <CheckBox fx:id="deleteBox" text="Delete"/>
    <Button text="Remove" onAction="#remove"/>
</fx:root>
