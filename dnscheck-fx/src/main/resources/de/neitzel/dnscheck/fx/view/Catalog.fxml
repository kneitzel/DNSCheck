<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.neitzel.dnscheck.fx.view.CatalogController"
            prefWidth="960" prefHeight="700">
    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>
    <fx:define>
        <BindingList>
            <DirectBinding control="zonesField" property="text" path="zonesDirectory" direction="both"/>
            <DirectBinding control="keysField" property="text" path="keysDirectory" direction="both"/>
            <DirectBinding control="entries" property="items" path="entries" direction="view"/>
            <DirectBinding control="entries" property="value" path="selected" direction="both"/>
            <DirectBinding control="noticeLabel" property="text" path="latestMessage" direction="view"/>
            <DirectBinding control="outcomeArea" property="text" path="outcome" direction="view"/>
        </BindingList>
    </fx:define>
    <top>
        <VBox spacing="8">
            <Label text="DNSCheck" style="-fx-font-size: 16px;"/>
            <HBox spacing="8">
                <Label text="Zones" minWidth="50"/>
                <TextField fx:id="zonesField" HBox.hgrow="ALWAYS"/>
                <Label text="Keys" minWidth="40"/>
                <TextField fx:id="keysField" HBox.hgrow="ALWAYS"/>
                <Button text="Reload" onAction="#reload"/>
            </HBox>
            <HBox spacing="8">
                <ComboBox fx:id="entries" promptText="Catalog entry" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Open" onAction="#open"/>
                <Button text="Dry-run file" onAction="#dryRun"/>
                <Button text="Reconcile file" onAction="#reconcile"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox fx:id="editorHost" spacing="8">
            <padding>
                <Insets top="12" right="0" bottom="0" left="0"/>
            </padding>
            <Label text="Open a catalog entry to edit its zone definition."/>
        </VBox>
    </center>
    <bottom>
        <VBox spacing="6">
            <padding>
                <Insets top="8" right="0" bottom="0" left="0"/>
            </padding>
            <Label text="Notice"/>
            <Label fx:id="noticeLabel" wrapText="true"/>
            <TextArea fx:id="outcomeArea" editable="false" wrapText="true" prefRowCount="6"/>
        </VBox>
    </bottom>
</BorderPane>
