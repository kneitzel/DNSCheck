<?xml version="1.0" encoding="UTF-8"?>

<?import de.neitzel.fx.docking.DockPane?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="de.neitzel.dnscheck.fx.view.CatalogController"
            prefWidth="1200" prefHeight="800">
    <fx:define>
        <BindingList>
            <DirectBinding control="directoryLabel" property="text" path="directory" direction="view"/>
        </BindingList>
    </fx:define>
    <top>
        <VBox spacing="6">
            <MenuBar fx:id="fileMenuBar">
                <Menu text="_File">
                    <MenuItem fx:id="openDirectoryMenu" text="_Open…" onAction="#browse" accelerator="Shortcut+O"/>
                    <MenuItem fx:id="reloadMenu" text="_Reload" onAction="#reload" accelerator="Shortcut+R"/>
                    <Menu fx:id="recentMenu" text="_Recent" onShowing="#refreshRecent"/>
                </Menu>
            </MenuBar>
            <Label fx:id="directoryLabel" style="-fx-padding: 0 12 6 12;"/>
        </VBox>
    </top>
    <center>
        <SplitPane fx:id="catalogSplit" dividerPositions="0.22">
            <VBox minWidth="160" prefWidth="240" spacing="8" style="-fx-padding: 8;">
                <Label text="Zones"/>
                <ListView fx:id="zonesList" VBox.vgrow="ALWAYS"/>
                <HBox spacing="8">
                    <Button fx:id="newZoneButton" text="New zone" onAction="#newZone" disable="true"/>
                    <Button fx:id="addKeyButton" text="Add key" onAction="#addKey" disable="true"/>
                </HBox>
            </VBox>
            <DockPane fx:id="editorHost"/>
        </SplitPane>
    </center>
    <bottom>
        <Label fx:id="statusLabel" wrapText="true" style="-fx-padding: 6 12 6 12;"/>
    </bottom>
</BorderPane>
