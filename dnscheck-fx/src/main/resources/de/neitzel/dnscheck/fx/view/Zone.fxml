<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>

<VBox fx:id="zoneRoot" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.neitzel.dnscheck.fx.view.ZoneController" spacing="8"
      stylesheets="@records.css">
    <fx:define>
        <BindingList>
            <DirectBinding control="zoneLabel" property="text" path="zone" direction="view"/>
            <DirectBinding control="nameserverField" property="text" path="nameserver" direction="both"/>
            <DirectBinding control="keyFileField" property="text" path="keyFile" direction="both"/>
            <DirectBinding control="outcomeArea" property="text" path="outcome" direction="view"/>
        </BindingList>
    </fx:define>
    <GridPane hgap="8" vgap="6">
        <columnConstraints><ColumnConstraints minWidth="110"/><ColumnConstraints hgrow="ALWAYS" minWidth="420"/></columnConstraints>
        <Label text="Zone" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="zoneLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Nameserver" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="nameserverField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Key file" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="keyFileField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="12">
        <Label text="✓ Enforced entry" styleClass="file-legend"/>
        <Label text="− Enforced removal" styleClass="removal-legend"/>
        <Label text="● Live only" styleClass="live-legend"/>
    </HBox>
    <Label fx:id="liveStatus" wrapText="true"/>
    <TableView fx:id="recordTable" id="recordTable" prefHeight="350" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="kindColumn" text="" prefWidth="40" sortable="false"/>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="190"/>
            <TableColumn fx:id="typeColumn" text="Type" prefWidth="70"/>
            <TableColumn fx:id="valueColumn" text="File / live value" prefWidth="280"/>
            <TableColumn fx:id="ttlColumn" text="TTL policy / live TTL" prefWidth="130"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="190"/>
        </columns>
    </TableView>
    <HBox spacing="8">
        <Button text="New record…" onAction="#addRecord"/>
        <Button text="Record details…" onAction="#editRecord"/>
        <Button text="Refresh live DNS" onAction="#refreshLive"/>
        <Button text="Save zone settings" onAction="#save"/>
    </HBox>
    <HBox spacing="8">
        <Button text="Save and dry-run" onAction="#dryRun"/>
        <Button text="Save and reconcile" onAction="#reconcile"/>
    </HBox>
    <TextArea fx:id="outcomeArea" editable="false" wrapText="true" prefRowCount="3"/>
</VBox>
