<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.Column?>
<?import de.neitzel.fx.view.DirectBinding?>
<?import de.neitzel.fx.view.Table?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="de.neitzel.dnscheck.fx.view.ZoneController" spacing="8">
    <fx:define>
        <BindingList>
            <DirectBinding control="ownerLabel" property="text" path="ownerFolder" direction="view"/>
            <DirectBinding control="zoneLabel" property="text" path="zone" direction="view"/>
            <DirectBinding control="nameserverField" property="text" path="nameserver" direction="both"/>
            <DirectBinding control="keyFileField" property="text" path="keyFile" direction="both"/>
            <DirectBinding control="noticeLabel" property="text" path="latestMessage" direction="view"/>
            <DirectBinding control="outcomeArea" property="text" path="outcome" direction="view"/>
        </BindingList>
    </fx:define>
    <GridPane hgap="8" vgap="6">
        <columnConstraints>
            <ColumnConstraints minWidth="110"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="420"/>
        </columnConstraints>
        <Label text="Owner" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="ownerLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Zone" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="zoneLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Nameserver" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="nameserverField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Key file" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="keyFileField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <Label text="Records" wrapText="true"/>
    <Label wrapText="true"
           text="Name, type, rdata, TTL (empty ignores TTL, -1 uses the zone default), pattern. Delete stores a deletion marker and ignores rdata. A column header sorts; its arrow filters."/>
    <Table fx:id="recordTable" id="recordTable" collection="records"
           row="de.neitzel.dnscheck.fx.view.RecordForm"
           prefHeight="240" maxHeight="Infinity" VBox.vgrow="ALWAYS">
        <Column header="Name" attribute="name" width="160"/>
        <Column header="Type" attribute="type" width="80"/>
        <Column header="Rdata" attribute="rdata" width="220"/>
        <Column header="TTL" attribute="ttl" width="90"/>
        <Column header="Pattern" attribute="rdataPattern" width="140"/>
        <Column header="Delete" attribute="deletionMarker" width="80"/>
    </Table>
    <HBox spacing="8">
        <Button text="Add record" onAction="#addRecord"/>
        <Button text="Save" onAction="#save"/>
        <Button text="Save and dry-run" onAction="#dryRun"/>
        <Button text="Save and reconcile" onAction="#reconcile"/>
    </HBox>
    <Label fx:id="noticeLabel" wrapText="true"/>
    <TextArea fx:id="outcomeArea" editable="false" wrapText="true" prefRowCount="4"/>
</VBox>
