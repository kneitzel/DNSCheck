<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import de.neitzel.fx.view.BindingList?>
<?import de.neitzel.fx.view.DirectBinding?>

<fx:root type="javafx.scene.layout.HBox" xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml" spacing="8" alignment="CENTER_LEFT">
    <fx:define>
        <BindingList>
            <DirectBinding control="zoneLabel" property="text" path="zone" direction="view"/>
            <DirectBinding control="nameserverLabel" property="text" path="nameserver" direction="view"/>
            <DirectBinding control="keyLabel" property="text" path="keyFile" direction="view"/>
            <DirectBinding control="validBox" property="selected" path="valid" direction="view"/>
            <DirectBinding control="errorLabel" property="text" path="error" direction="view"/>
        </BindingList>
    </fx:define>
    <Label fx:id="zoneLabel"/>
    <Label fx:id="nameserverLabel"/>
    <Label fx:id="keyLabel"/>
    <CheckBox fx:id="validBox" disable="true"/>
    <Label fx:id="errorLabel"/>
</fx:root>
